# Copy to .env and edit to rotate the loot without touching code.
# Unset/empty values fall back to the defaults in config.py.
#
# S5 (portal path) is the answer that unlocks Firewall 2 in CTFd. It is fixed to
# the real F2 entry path and is intentionally NOT listed here as rotatable.
# If you rotate any value, update the matching CTFd answer.

LOOT_S1=ADI-2291                       # staff ID (login username)
LOOT_S2=MochiDune#2004                 # Lena's password = pet+book+#+year (policy)
LOOT_S3=SKYLINE                        # migration codename (project folder name)
LOOT_S4=106                            # the "deleted" post that is still live (in /post/106)
LOOT_S6=adi-setup-override-7731        # bonus setup code (in the poster SVG)

# If you rotate LOOT_S2, keep the clues consistent: pet (Mochi) in the comments
# on post 127, book (Dune) in post 125, year ("turned 22") in post 123 - and keep
# it matching the signup policy shape letters+#+4digits, or it is unsolvable.
# F1_SESSION_KEY rotates the login cookie signing key (server-only; never served
# to the client). A fresh random value is fine.
# F1_SESSION_KEY=change-me-per-event

# Network (defaults shown). Port 5000 avoids clashing with Firewall 2 (:80).
HOST=0.0.0.0
PORT=5000
